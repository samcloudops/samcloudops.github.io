<style>
:root {
  --bg:#080e19;
  --panel:#0e1928;
  --panel2:#111f30;
  --cyan:#62d9f5;
  --blue:#438cff;
  --text:#edf5ff;
  --muted:#93a5b9;
  --line:rgba(148,190,220,.14);
  --mono:'DM Mono',monospace;
  --sans:'Manrope',sans-serif;
}
*{margin:0;padding:0;box-sizing:border-box;scroll-behavior:smooth}
body{
  background:var(--bg);color:var(--text);
  font-family:var(--sans);line-height:1.7;
  overflow-x:hidden;
}
body:before{
  content:"";position:fixed;inset:0;pointer-events:none;z-index:-1;
  background:
    radial-gradient(ellipse at 80% 5%,rgba(30,122,220,.15),transparent 38%),
    radial-gradient(ellipse at 10% 50%,rgba(20,170,210,.07),transparent 40%);
}
a{color:inherit;text-decoration:none}
.container{width:min(1100px,90%);margin:auto}
nav{
  position:sticky;top:0;z-index:50;
  background:rgba(8,14,25,.86);
  backdrop-filter:blur(18px);
  border-bottom:1px solid var(--line);
}
.nav-inner{
  min-height:76px;display:flex;align-items:center;
  justify-content:space-between;gap:20px;
}
.logo{font-size:22px;font-weight:800;letter-spacing:2px}
.logo span{color:var(--cyan)}
.nav-links{display:flex;gap:25px;list-style:none}
.nav-links a{font-size:12px;color:var(--muted);transition:.2s}
.nav-links a:hover{color:var(--cyan)}
.menu{display:none;background:none;border:1px solid var(--line);
color:white;border-radius:8px;padding:8px 12px}
.hero{min-height:660px;display:flex;align-items:center;padding:90px 0}
.eyebrow{
  color:var(--cyan);font:12px var(--mono);
  letter-spacing:2px;margin-bottom:22px;
}
.hero h1{
  font-size:clamp(43px,8vw,82px);
  line-height:1.08;letter-spacing:-4px;
  font-weight:800;margin-bottom:20px;
}
.gradient{
  background:linear-gradient(100deg,#fff,#64d9f5,#5797ff);
  background-clip:text;-webkit-background-clip:text;color:transparent;
}
.role{font-size:clamp(19px,3vw,28px);font-weight:600;margin-bottom:18px}
.hero-desc{color:var(--muted);max-width:610px;font-size:15px}
.actions{display:flex;gap:13px;flex-wrap:wrap;margin-top:30px}
.btn{
  display:inline-flex;align-items:center;justify-content:center;
  gap:9px;padding:12px 20px;border-radius:8px;
  font-size:12px;font-weight:700;transition:.25s;
}
.primary{background:var(--cyan);color:#06111b}
.secondary{border:1px solid var(--line);color:var(--text)}
.btn:hover{transform:translateY(-3px)}
.status{
  display:inline-flex;align-items:center;gap:9px;
  margin-top:40px;color:var(--muted);font:11px var(--mono);
}
.dot{width:8px;height:8px;border-radius:50%;background:#49d69a;
box-shadow:0 0 12px #49d69a}
.section{padding:90px 0;border-top:1px solid var(--line)}
.section-label{font:11px var(--mono);color:var(--cyan);letter-spacing:2px}
.section-title{font-size:clamp(29px,5vw,43px);margin:10px 0 15px}
.section-intro{color:var(--muted);max-width:650px;font-size:14px}
.about-grid{
  display:grid;grid-template-columns:1.2fr .8fr;
  gap:30px;margin-top:40px;
}
.panel{
  background:linear-gradient(145deg,var(--panel2),var(--panel));
  border:1px solid var(--line);border-radius:14px;padding:28px;
}
.panel p{color:var(--muted);font-size:14px;margin-top:12px}
.terminal{
  font:12px/2 var(--mono);color:#b8cbdc;
  background:#080e17;border:1px solid var(--line);
  border-radius:10px;padding:20px;overflow-wrap:anywhere;
}
.terminal .green{color:#65e5b2}
.terminal .cyan{color:var(--cyan)}
.skills-grid{
  display:grid;grid-template-columns:repeat(3,1fr);
  gap:15px;margin-top:35px;
}
.skill{
  padding:23px;border:1px solid var(--line);
  border-radius:12px;background:var(--panel);
}
.skill h3{font-size:15px;margin-bottom:12px}
.tags{display:flex;flex-wrap:wrap;gap:7px}
.tag{
  padding:6px 10px;border:1px solid var(--line);
  background:rgba(100,180,220,.05);border-radius:6px;
  font:10px var(--mono);color:#b8d2e5;
}
.projects-grid{
  display:grid;grid-template-columns:repeat(2,1fr);
  gap:17px;margin-top:35px;
}
.project{
  padding:26px;border:1px solid var(--line);
  border-radius:13px;background:var(--panel);
  transition:.25s;
}
.project:hover{border-color:rgba(98,217,245,.5);transform:translateY(-4px)}
.project-icon{font-size:24px;margin-bottom:17px}
.project h3{font-size:18px;margin-bottom:8px}
.project p{font-size:13px;color:var(--muted);margin-bottom:18px}
.project-status{font:10px var(--mono);color:var(--cyan)}
.journey{margin-top:35px;border-left:1px solid #28607d;padding-left:25px}
.journey-item{position:relative;padding:0 0 30px}
.journey-item:before{
  content:"";position:absolute;width:9px;height:9px;
  border-radius:50%;background:var(--cyan);
  left:-30px;top:8px;box-shadow:0 0 12px var(--cyan);
}
.journey-item h3{font-size:15px}
.journey-item p{font-size:12px;color:var(--muted)}
.contact-box{
  margin-top:35px;padding:35px;border:1px solid var(--line);
  background:linear-gradient(120deg,#102b43,#101a2a);
  border-radius:15px;
}
.contact-box p{color:var(--muted);font-size:14px;margin:12px 0 20px}
footer{padding:30px 0;border-top:1px solid var(--line)}
.footer-inner{display:flex;justify-content:space-between;gap:15px;flex-wrap:wrap}
footer p{font:10px var(--mono);color:var(--muted)}
.reveal{opacity:0;transform:translateY(18px);transition:.7s}
.reveal.show{opacity:1;transform:translateY(0)}
@media(max-width:760px){
 .nav-links{
  display:none;position:absolute;top:76px;left:0;right:0;
